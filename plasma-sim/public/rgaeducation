<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RGA 시뮬레이터</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Noto Sans+KR:wght@300;400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#0a0e1a;color:#e0e0e0;font-family:'Noto Sans KR',sans-serif;min-height:100vh;}
.header{background:linear-gradient(135deg,#0d1b2a,#1a2744);border-bottom:2px solid rgba(0,245,255,0.2);padding:14px 24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.header-icon{width:42px;height:42px;background:linear-gradient(135deg,#00f5ff,#0080ff);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;}
.header-title{font-family:'Orbitron',sans-serif;font-size:15px;color:#00f5ff;letter-spacing:2px;}
.header-sub{font-size:11px;color:#8899aa;margin-top:2px;}
.status-bar{margin-left:auto;display:flex;gap:20px;}
.status-item{display:flex;flex-direction:column;align-items:center;}
.status-val{font-family:'Orbitron',sans-serif;font-size:12px;color:#00ff88;}
.status-lbl{font-size:10px;color:#556677;margin-top:2px;}
.tabs{display:flex;background:#080c14;border-bottom:1px solid #1a2744;overflow-x:auto;}
.tab{padding:11px 18px;cursor:pointer;font-size:13px;color:#667788;border-bottom:3px solid transparent;white-space:nowrap;transition:all .2s;user-select:none;}
.tab:hover{color:#aabbcc;}
.tab.active{color:#00f5ff;border-bottom-color:#00f5ff;background:#0d1b2a;}
.tab-num{font-family:'Orbitron',sans-serif;font-size:10px;color:#334455;margin-right:5px;}
.panel{display:none;padding:18px;max-width:1100px;margin:0 auto;}
.panel.active{display:block;}
.card{background:#0d1b2a;border:1px solid #1a2744;border-radius:10px;padding:16px;margin-bottom:14px;}
.card-title{font-family:'Orbitron',sans-serif;font-size:11px;color:#00f5ff;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.card-title::before{content:'';width:4px;height:13px;background:#00f5ff;border-radius:2px;flex-shrink:0;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
.cb{background:#060d18;border-left:3px solid #ff6b00;padding:13px;border-radius:0 8px 8px 0;margin-bottom:10px;}
.cb h4{color:#ff9944;font-size:13px;margin-bottom:5px;}
.cb p{font-size:13px;color:#aabbc0;line-height:1.75;}
.hl{color:#00f5ff;font-weight:700;}
.wn{color:#ff6b00;font-weight:700;}
.spec-canvas{display:block;width:100%;height:260px;background:#060d18;border:1px solid #1a2744;border-radius:8px;}
.ctrl-row{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:12px;}
.ctrl-group{display:flex;flex-direction:column;gap:4px;}
.ctrl-label{font-size:11px;color:#7788aa;}
select,input[type=range]{background:#0a1420;border:1px solid #1e3050;color:#ccdde8;padding:5px 9px;border-radius:6px;font-size:13px;font-family:'Noto Sans KR',sans-serif;}
select{cursor:pointer;}
input[type=range]{-webkit-appearance:none;appearance:none;height:6px;border-radius:3px;outline:none;cursor:pointer;padding:0;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;background:#00f5ff;border-radius:50%;}
.btn{padding:7px 15px;border:none;border-radius:6px;cursor:pointer;font-size:13px;font-family:'Noto Sans KR',sans-serif;transition:all .2s;font-weight:700;}
.btn-cyan{background:linear-gradient(135deg,#005f6b,#00a8b5);color:#fff;}
.btn-cyan:hover{background:linear-gradient(135deg,#007a88,#00c8d8);}
.btn-orange{background:linear-gradient(135deg,#7a3000,#c05000);color:#fff;}
table{width:100%;border-collapse:collapse;font-size:13px;}
th{background:#0a1828;color:#7799bb;font-weight:400;padding:7px 11px;text-align:left;border-bottom:1px solid #1a2744;}
td{padding:6px 11px;border-bottom:1px solid #0f1e30;color:#cce0ee;}
tr:hover td{background:#0d1e34;}
.badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:11px;}
.badge-ok{background:#003322;color:#00cc88;}
.badge-warn{background:#332200;color:#ff9900;}
.badge-alert{background:#330000;color:#ff4444;}
.scen-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:9px;margin-bottom:14px;}
.scen-btn{padding:11px;border:1px solid #1a2744;border-radius:8px;background:#0a1420;cursor:pointer;text-align:left;transition:all .2s;}
.scen-btn:hover,.scen-btn.active{border-color:rgba(0,245,255,0.4);background:#0d2030;}
.scen-btn h5{font-size:12px;color:#00f5ff;margin-bottom:3px;}
.scen-btn p{font-size:11px;color:#667788;}
.di{display:flex;align-items:flex-start;gap:11px;padding:11px;border-radius:8px;margin-bottom:7px;}
.di-ok{background:#001a10;border:1px solid #004422;}
.di-w{background:#1a1000;border:1px solid #443300;}
.di-a{background:#1a0000;border:1px solid #440000;}
.di-icon{font-size:19px;flex-shrink:0;line-height:1;}
.di-text h4{font-size:13px;font-weight:700;margin-bottom:3px;}
.di-text p{font-size:12px;color:#aabbcc;line-height:1.65;}
/* 퀴즈 - 글자 명확히 보이게 */
.quiz-q{background:#060d18;border:1px solid #1a2744;border-radius:8px;padding:14px;margin-bottom:11px;}
.quiz-q p{font-size:13px;color:#ddeeff;margin-bottom:11px;line-height:1.7;}
.quiz-opts{display:flex;flex-direction:column;gap:6px;}
.quiz-opt{padding:9px 14px;border:1px solid #2a3d55;border-radius:6px;background:#0d1e34;cursor:pointer;font-size:13px;color:#ccdde8;transition:all .2s;text-align:left;font-family:'Noto Sans KR',sans-serif;}
.quiz-opt:hover{border-color:rgba(0,245,255,0.4);background:#102030;color:#fff;}
.quiz-opt.correct{background:#002a15;border-color:#00aa55;color:#00ff88 !important;}
.quiz-opt.wrong{background:#2a0000;border-color:#aa0000;color:#ff6666 !important;}
.quiz-opt:disabled,.quiz-opt[data-locked]{cursor:default;}
.quiz-score{font-family:'Orbitron',sans-serif;font-size:26px;color:#00f5ff;text-align:center;padding:20px 0;}
.legend{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px;}
.leg-item{display:flex;align-items:center;gap:5px;font-size:12px;color:#8899bb;}
.leg-dot{width:11px;height:11px;border-radius:2px;flex-shrink:0;}
/* 모니터링 */
.monitor-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;}
.monitor-box{background:#060d18;border:1px solid #1a2744;border-radius:8px;padding:10px 14px;flex:1;min-width:110px;}
.monitor-label{font-size:10px;color:#556677;margin-bottom:4px;}
.monitor-val{font-family:'Orbitron',sans-serif;font-size:14px;color:#00ff88;}
.monitor-val.warn{color:#ff9900;}
.monitor-val.alert{color:#ff4444;}
/* 트렌드 캔버스 */
.trend-canvas{display:block;width:100%;height:110px;background:#060d18;border:1px solid #1a2744;border-radius:8px;}
/* step tabs */
.step-tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;}
.step-tab{padding:7px 13px;border:1px solid #1a2744;border-radius:6px;background:#0a1420;cursor:pointer;font-size:12px;color:#7788aa;transition:all .2s;}
.step-tab:hover{color:#aabbcc;}
.step-tab.active{background:#0d2030;border-color:rgba(0,245,255,0.4);color:#00f5ff;}
.step-panel{display:none;}
.step-panel.active{display:block;}
.svg-wrap{width:100%;overflow-x:auto;}
svg text{font-family:'Noto Sans KR',sans-serif;}
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:#080c14;}
::-webkit-scrollbar-thumb{background:#1e3050;border-radius:3px;}
</style>
</head>
<body>

<div class="header">
  <div class="header-icon">🔬</div>
  <div>
    <div class="header-title">RGA SIMULATOR</div>
    <div class="header-sub">Residual Gas Analyzer — 잔류 가스 분석기 교육 시뮬레이터</div>
  </div>
  <div class="status-bar">
    <div class="status-item"><div class="status-val" id="hdrPressure">—</div><div class="status-lbl">Total (Torr)</div></div>
    <div class="status-item"><div class="status-val" id="hdrMode" style="color:#ff9900">STANDBY</div><div class="status-lbl">RGA Status</div></div>
    <div class="status-item"><div class="status-val" id="hdrScan">—</div><div class="status-lbl">Scan #</div></div>
  </div>
</div>

<div class="tabs">
  <div class="tab active" onclick="showTab(0)"><span class="tab-num">01</span>개념 학습</div>
  <div class="tab" onclick="showTab(1)"><span class="tab-num">02</span>가상 실험</div>
  <div class="tab" onclick="showTab(2)"><span class="tab-num">03</span>진단 훈련</div>
  <div class="tab" onclick="showTab(3)"><span class="tab-num">04</span>퀴즈</div>
</div>

<!-- ===== TAB 01 개념학습 ===== -->
<div class="panel active" id="tab0">
  <div class="step-tabs">
    <div class="step-tab active" onclick="showStep(0)">① RGA 개요</div>
    <div class="step-tab" onclick="showStep(1)">② 내부 구조</div>
    <div class="step-tab" onclick="showStep(2)">③ 작동 원리</div>
    <div class="step-tab" onclick="showStep(3)">④ 스펙트럼 해석</div>
    <div class="step-tab" onclick="showStep(4)">⑤ Leak vs Outgassing</div>
  </div>

  <!-- STEP 0 -->
  <div class="step-panel active" id="step0">
    <div class="card">
      <div class="card-title">RGA 개요 — 왜 필요한가?</div>
      <div class="svg-wrap">
        <svg viewBox="0 0 720 190" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:720px;">
          <rect width="720" height="190" fill="#060d18" rx="8"/>
          <rect x="30" y="40" width="150" height="110" rx="8" fill="#0d2030" stroke="#1e4060" stroke-width="1.5"/>
          <text x="105" y="65" text-anchor="middle" fill="#7799bb" font-size="11">진공 게이지</text>
          <text x="105" y="83" text-anchor="middle" fill="#00f5ff" font-size="13" font-weight="bold">Pressure Only</text>
          <text x="105" y="100" text-anchor="middle" fill="#aabbcc" font-size="11">1×10⁻⁸ Torr</text>
          <text x="105" y="120" text-anchor="middle" fill="#ff6b00" font-size="11">양적 정보만</text>
          <text x="105" y="138" text-anchor="middle" fill="#556677" font-size="10">(어떤 가스인지 모름)</text>
          <line x1="185" y1="95" x2="230" y2="95" stroke="#334455" stroke-width="1.5" stroke-dasharray="5,3"/>
          <text x="207" y="88" text-anchor="middle" fill="#556677" font-size="10">vs</text>
          <rect x="235" y="25" width="200" height="140" rx="8" fill="#0d2a10" stroke="#00aa55" stroke-width="1.5"/>
          <text x="335" y="48" text-anchor="middle" fill="#00cc88" font-size="12" font-weight="bold">RGA</text>
          <text x="335" y="64" text-anchor="middle" fill="#7799bb" font-size="10">질적 + 양적 정보</text>
          <rect x="248" y="72" width="174" height="15" rx="3" fill="#001a10"/>
          <rect x="248" y="72" width="140" height="15" rx="3" fill="#003322"/>
          <text x="335" y="83" text-anchor="middle" fill="#00f5ff" font-size="10">H₂ ████████ 80%</text>
          <rect x="248" y="91" width="174" height="15" rx="3" fill="#001a10"/>
          <rect x="248" y="91" width="55" height="15" rx="3" fill="#002244"/>
          <text x="335" y="102" text-anchor="middle" fill="#0088ff" font-size="10">H₂O ██ 15%</text>
          <rect x="248" y="110" width="174" height="15" rx="3" fill="#001a10"/>
          <rect x="248" y="110" width="26" height="15" rx="3" fill="#221100"/>
          <text x="335" y="121" text-anchor="middle" fill="#ff9900" font-size="10">N₂ █ 5%</text>
          <text x="335" y="150" text-anchor="middle" fill="#aabbcc" font-size="10">가스 조성 정보 제공</text>
          <defs><marker id="arr" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="#00aa55"/></marker></defs>
          <line x1="437" y1="95" x2="455" y2="95" stroke="#00aa55" stroke-width="1.5" marker-end="url(#arr)"/>
          <rect x="458" y="30" width="235" height="130" rx="8" fill="#0d1b2a" stroke="#1a2744" stroke-width="1.2"/>
          <text x="575" y="52" text-anchor="middle" fill="#ff9900" font-size="12" font-weight="bold">RGA로 알 수 있는 것</text>
          <text x="575" y="70" text-anchor="middle" fill="#aabbcc" font-size="11">✓ 수분 오염 유무</text>
          <text x="575" y="87" text-anchor="middle" fill="#aabbcc" font-size="11">✓ 공기 누출(Leak) 진단</text>
          <text x="575" y="104" text-anchor="middle" fill="#aabbcc" font-size="11">✓ 오일 역류 감지</text>
          <text x="575" y="121" text-anchor="middle" fill="#aabbcc" font-size="11">✓ 공정 가스 조성 확인</text>
          <text x="575" y="138" text-anchor="middle" fill="#aabbcc" font-size="11">✓ 이상 조기 진단</text>
        </svg>
      </div>
    </div>
    <div class="grid2">
      <div class="cb" style="border-radius:8px;"><h4>압력 게이지와의 차이</h4><p>진공 게이지는 <span class="hl">총압력(양적)</span>만 알려줍니다. RGA는 어떤 가스가 어느 비율로 있는지 <span class="hl">조성(질적) 정보</span>까지 제공합니다. 같은 압력이라도 H₂O가 많으면 공정 결과는 완전히 달라집니다.</p></div>
      <div class="cb" style="border-left-color:#00f5ff;border-radius:8px;"><h4>동작 압력 범위</h4><p>RGA는 이온이 필드만 받으며 자유롭게 이동하려면 <span class="hl">고진공(10⁻⁴ Torr 이하)</span>이 필수입니다. 최적 동작 범위는 <span class="hl">10⁻⁶ ~ 10⁻⁸ Torr</span>이며, 고압에서는 필라멘트 손상 위험이 있습니다.</p></div>
    </div>
  </div>

  <!-- STEP 1 -->
  <div class="step-panel" id="step1">
    <div class="card">
      <div class="card-title">RGA 내부 구조 상세도</div>
      <div class="svg-wrap">
        <svg viewBox="0 0 740 300" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:740px;">
          <rect width="740" height="300" fill="#060d18" rx="8"/>
          <defs>
            <marker id="g1" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="#00ff88"/></marker>
          </defs>
          <rect x="30" y="110" width="620" height="80" rx="6" fill="#0a1828" stroke="#1e3050" stroke-width="1.5"/>
          <text x="340" y="104" text-anchor="middle" fill="#556677" font-size="11">— RGA 프로브 (Probe) 단면 —</text>
          <!-- 이온화부 -->
          <rect x="40" y="118" width="128" height="64" rx="5" fill="#0d2a10" stroke="#00aa55" stroke-width="1.5"/>
          <text x="104" y="138" text-anchor="middle" fill="#00cc88" font-size="11" font-weight="bold">이온화부</text>
          <text x="104" y="153" text-anchor="middle" fill="#88bbaa" font-size="9">(Ionizer)</text>
          <path d="M58,172 Q74,162 90,172 Q106,182 122,172 Q138,162 154,172" stroke="#ffcc00" stroke-width="2" fill="none"/>
          <text x="104" y="186" text-anchor="middle" fill="#ffcc00" font-size="8">Filament</text>
          <!-- 이온 렌즈 -->
          <rect x="178" y="118" width="66" height="64" rx="5" fill="#0d1a30" stroke="#0066aa" stroke-width="1.5"/>
          <text x="211" y="142" text-anchor="middle" fill="#4499cc" font-size="10" font-weight="bold">이온</text>
          <text x="211" y="156" text-anchor="middle" fill="#4499cc" font-size="10" font-weight="bold">렌즈</text>
          <text x="211" y="170" text-anchor="middle" fill="#7799aa" font-size="8">Ion Lens</text>
          <!-- 사중극자 -->
          <rect x="254" y="108" width="226" height="84" rx="5" fill="#1a1000" stroke="#ff9900" stroke-width="1.5"/>
          <text x="367" y="128" text-anchor="middle" fill="#ff9900" font-size="11" font-weight="bold">사중극자 질량 필터</text>
          <text x="367" y="143" text-anchor="middle" fill="#aa7700" font-size="9">(Quadrupole Mass Filter)</text>
          <ellipse cx="305" cy="168" rx="11" ry="6" fill="#3a2000" stroke="#ff9900" stroke-width="1.2"/>
          <ellipse cx="367" cy="161" rx="11" ry="6" fill="#3a2000" stroke="#ff9900" stroke-width="1.2"/>
          <ellipse cx="430" cy="168" rx="11" ry="6" fill="#3a2000" stroke="#ff9900" stroke-width="1.2"/>
          <ellipse cx="367" cy="175" rx="11" ry="6" fill="#3a2000" stroke="#ff9900" stroke-width="1.2"/>
          <text x="367" y="188" text-anchor="middle" fill="#886600" font-size="8">RF+DC 전압 인가</text>
          <!-- 검출기 -->
          <rect x="490" y="118" width="110" height="64" rx="5" fill="#1a0a1a" stroke="#aa44ff" stroke-width="1.5"/>
          <text x="545" y="140" text-anchor="middle" fill="#cc88ff" font-size="11" font-weight="bold">검출기</text>
          <text x="545" y="155" text-anchor="middle" fill="#9966cc" font-size="9">(Detector)</text>
          <text x="545" y="168" text-anchor="middle" fill="#7755aa" font-size="8">Faraday Cup / SEM</text>
          <!-- 화살표 -->
          <line x1="170" y1="150" x2="176" y2="150" stroke="#00ff88" stroke-width="1.5" marker-end="url(#g1)"/>
          <line x1="246" y1="150" x2="252" y2="150" stroke="#00ff88" stroke-width="1.5" marker-end="url(#g1)"/>
          <line x1="482" y1="150" x2="488" y2="150" stroke="#00ff88" stroke-width="1.5" marker-end="url(#g1)"/>
          <line x1="15" y1="150" x2="38" y2="150" stroke="#00f5ff" stroke-width="2" marker-end="url(#g1)"/>
          <text x="8" y="145" fill="#00f5ff" font-size="9" text-anchor="middle">가스</text>
          <text x="8" y="157" fill="#00f5ff" font-size="9" text-anchor="middle">유입</text>
          <!-- ECU -->
          <rect x="610" y="85" width="118" height="130" rx="6" fill="#0a1428" stroke="#334466" stroke-width="1.2"/>
          <text x="669" y="105" text-anchor="middle" fill="#7799bb" font-size="11" font-weight="bold">ECU</text>
          <text x="669" y="120" text-anchor="middle" fill="#556677" font-size="9">전자 제어부</text>
          <rect x="620" y="128" width="98" height="13" rx="3" fill="#0d2030"/>
          <text x="669" y="138" text-anchor="middle" fill="#00f5ff" font-size="8">RF/DC Generator</text>
          <rect x="620" y="145" width="98" height="13" rx="3" fill="#0d2030"/>
          <text x="669" y="155" text-anchor="middle" fill="#00f5ff" font-size="8">Ion Current Amp</text>
          <rect x="620" y="162" width="98" height="13" rx="3" fill="#0d2030"/>
          <text x="669" y="172" text-anchor="middle" fill="#00f5ff" font-size="8">Data Processing</text>
          <rect x="624" y="230" width="90" height="42" rx="5" fill="#080c14" stroke="#223344" stroke-width="1"/>
          <rect x="632" y="237" width="74" height="27" rx="2" fill="#0d1e30"/>
          <text x="669" y="254" text-anchor="middle" fill="#00f5ff" font-size="9">PC / Software</text>
          <line x1="669" y1="215" x2="669" y2="230" stroke="#334466" stroke-width="1" stroke-dasharray="3,2"/>
          <!-- 번호 -->
          <circle cx="104" cy="210" r="10" fill="#00aa55"/><text x="104" y="214" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold">1</text>
          <circle cx="211" cy="210" r="10" fill="#0066aa"/><text x="211" y="214" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold">2</text>
          <circle cx="367" cy="210" r="10" fill="#cc7700"/><text x="367" y="214" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold">3</text>
          <circle cx="545" cy="210" r="10" fill="#8833cc"/><text x="545" y="214" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold">4</text>
