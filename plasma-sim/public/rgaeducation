  {id:'d4',label:'케이스 D',hint:'m/z 41~70 복수',key:'oil'},
  {id:'d5',label:'케이스 E',hint:'m/z 2 dominant',key:'clean'},
];
const DIAG_INFO = {
  clean:      {cls:'di-ok',ic:'✅',title:'정상 상태',       desc:'H₂ 우세, H₂O 소량. 진공 시스템 정상.'},
  moisture:   {cls:'di-w', ic:'💧',title:'수분 오염',       desc:'m/z 18(H₂O)+17(OH⁺) 동시 증가. 베이킹 권장.'},
  leak:       {cls:'di-a', ic:'🔴',title:'Air Leak 의심',   desc:'m/z 28(N₂),32(O₂),40(Ar) 공기비율 패턴. 연결부 점검.'},
  oil:        {cls:'di-w', ic:'🛢',title:'오일/HC 오염',    desc:'m/z 41~70 복수 HC 피크. 펌프 역류 or 유기 오염.'},
  process_ar: {cls:'di-ok',ic:'⚛',title:'Ar 공정 잔류',    desc:'m/z 40 강세, 36/38 동위원소 피크. 정상 스퍼터링 패턴.'},
};
const QUIZ = [
  {q:'RGA와 진공 게이지의 가장 큰 차이는?',opts:['측정 속도 차이','가스 조성 정보 제공 가능','가격 차이','설치 위치 차이'],ans:1},
  {q:'m/z = 18에서 강한 피크 → 가장 먼저 의심해야 할 것은?',opts:['공기 누출','수분 오염','오일 역류','플라즈마 방전'],ans:1},
  {q:'RGA 내부에 고진공(10⁻⁶ Torr 이하)이 필요한 이유는?',opts:['필라멘트 냉각을 위해','이온이 다른 분자와 충돌 없이 통과하기 위해(평균 자유 경로)','사중극자 전압이 높아서','검출기 보호를 위해'],ans:1},
  {q:'Air Leak 시 동시에 증가하는 피크 조합은?',opts:['m/z 2, 18','m/z 28, 32, 40','m/z 44, 55, 69','m/z 18, 17'],ans:1},
  {q:'고압 챔버(10⁻² Torr)에서 RGA를 사용하려면?',opts:['직접 연결해도 무방','RGA 앞에 TMP + 리크 밸브(차동 펌핑) 구성 필요','챔버 압력을 높이면 됨','Faraday Cup을 SEM으로 교체'],ans:1},
  {q:'m/z = 28을 단독으로 N₂라고 단정하면 안 되는 이유는?',opts:['N₂는 RGA로 측정 불가','CO도 m/z=28이기 때문','28은 Ar 피크','피크가 낮기 때문'],ans:1},
];

// ── STATE ─────────────────────────────────────────────
let scanCount=0, isScanning=false, scanTimer=null;
let activeDiagKey='leak', quizAnswers={};
// trend data: 각 가스별 최근 30포인트
const TREND_KEYS=[2,18,28,32,40];
const TREND_COLORS={2:'#00f5ff',18:'#0088ff',28:'#ff9900',32:'#ff4455',40:'#aa44ff'};
let trendData={};
TREND_KEYS.forEach(k=>trendData[k]=[]);

// ── TABS / STEPS ──────────────────────────────────────
function showTab(i){
  document.querySelectorAll('.panel').forEach((p,j)=>p.classList.toggle('active',i===j));
  document.querySelectorAll('.tab').forEach((t,j)=>t.classList.toggle('active',i===j));
  if(i===1) requestAnimationFrame(()=>drawSpectrum('specCanvas'));
  if(i===2){initDiag();requestAnimationFrame(()=>drawDiagCanvas());}
}
function showStep(i){
  document.querySelectorAll('.step-panel').forEach((p,j)=>p.classList.toggle('active',i===j));
  document.querySelectorAll('.step-tab').forEach((t,j)=>t.classList.toggle('active',i===j));
}

// ── CANVAS SPECTRUM ───────────────────────────────────
function drawCanvas(id, peaks, maxRange, yLog, noise){
  const canvas=document.getElementById(id);
  if(!canvas) return [];
  const rect=canvas.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  const W=rect.width||600, H=rect.height||260;
  canvas.width=Math.round(W*dpr); canvas.height=Math.round(H*dpr);
  const ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  const pad={l:56,r:16,t:22,b:36};
  const gW=W-pad.l-pad.r, gH=H-pad.t-pad.b;

  ctx.fillStyle='#060d18'; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#0f1e30'; ctx.lineWidth=1;
  for(let i=0;i<=10;i++){
    const y=pad.t+gH*i/10;
    ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(W-pad.r,y);ctx.stroke();
    const x=pad.l+gW*i/10;
    ctx.beginPath();ctx.moveTo(x,pad.t);ctx.lineTo(x,pad.t+gH);ctx.stroke();
  }
  ctx.strokeStyle='#1e3050'; ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(pad.l,pad.t);ctx.lineTo(pad.l,pad.t+gH);ctx.lineTo(W-pad.r,pad.t+gH);ctx.stroke();

  ctx.fillStyle='#556677'; ctx.font='11px sans-serif'; ctx.textAlign='center';
  const xStep=maxRange<=50?5:maxRange<=100?10:20;
  for(let x=0;x<=maxRange;x+=xStep) ctx.fillText(x, pad.l+gW*x/maxRange, pad.t+gH+15);
  ctx.save();ctx.translate(12,pad.t+gH/2);ctx.rotate(-Math.PI/2);
  ctx.fillText(yLog?'log Intensity':'Intensity',0,0);ctx.restore();
  ctx.fillText('m/z',pad.l+gW/2,H-2);

  const maxI=Math.max(...Object.values(peaks),1);
  const rows=[];

  if(noise>0){
    ctx.fillStyle='#1a3040';
    for(let m=1;m<=maxRange;m++){
      const n=noise*Math.random()*0.01;
      const px=pad.l+gW*m/maxRange;
      const py=yLog?pad.t+gH*(1-Math.log10(1+n*99)/2):pad.t+gH*(1-n);
      ctx.fillRect(px-0.5,Math.max(py,pad.t),1,pad.t+gH-Math.max(py,pad.t));
    }
  }

  Object.entries(peaks).forEach(([mzStr,intensity])=>{
    const mz=parseInt(mzStr,10);
    if(mz>maxRange||mz<1) return;
    const nd=noise>0?intensity*(1+(Math.random()-0.5)*0.06*noise):intensity;
    const frac=Math.min(nd/maxI,1);
    const px=pad.l+gW*mz/maxRange;
    const py=yLog?pad.t+gH*(1-Math.log10(1+frac*99)/Math.log10(100)):pad.t+gH*(1-frac);
    const bH=pad.t+gH-py;
    if(bH<1) return;
    const info=GAS_INFO[mz]||{name:`m/z${mz}`,color:'#8899aa'};
    const g=ctx.createLinearGradient(0,py,0,pad.t+gH);
    g.addColorStop(0,info.color); g.addColorStop(1,info.color+'22');
    ctx.fillStyle=g;
    ctx.fillRect(px-3,py,6,bH);
    if(frac>0.07){
      ctx.fillStyle=info.color; ctx.font='bold 11px sans-serif'; ctx.textAlign='center';
      ctx.fillText(mz,px,py-14);
      ctx.font='10px sans-serif'; ctx.fillText(info.name,px,py-4);
    }
    rows.push({mz,name:info.name,rel:Math.round(frac*100),torr:(frac*2.4e-8),color:info.color});
  });
  return rows;
}

function getPeaks(){
  const scen=document.getElementById('scenario').value;
  if(scen==='custom') return {
    2:+document.getElementById('g2').value,18:+document.getElementById('g18').value,
    28:+document.getElementById('g28').value,32:+document.getElementById('g32').value,
    40:+document.getElementById('g40').value,44:+document.getElementById('g44').value,
  };
  return SCENARIOS[scen]?{...SCENARIOS[scen].peaks}:{};
}

function drawSpectrum(cid){
  const noise=parseInt(document.getElementById('noiseLevel').value,10);
  const maxRange=parseInt(document.getElementById('massRange').value,10);
  const yLog=document.getElementById('yScale').value==='log';
  const peaks=getPeaks();
  const rows=drawCanvas(cid||'specCanvas',peaks,maxRange,yLog,noise);

  if(!cid||cid==='specCanvas'){
    // 모니터링 업데이트
    const maxI=Math.max(...Object.values(peaks),1);
    updateMonitor(peaks,maxI);

    const tb=document.getElementById('peakTbody'); tb.innerHTML='';
    rows.sort((a,b)=>b.rel-a.rel).forEach(r=>{
      const badge=r.rel>60?`<span class="badge badge-alert">HIGH</span>`:r.rel>20?`<span class="badge badge-warn">주의</span>`:`<span class="badge badge-ok">정상</span>`;
      const tr=document.createElement('tr');
      tr.innerHTML=`<td style="color:${r.color}">${r.mz}</td><td>${r.name}</td><td>${r.rel}%</td><td>${r.torr.toExponential(1)}</td><td>${badge}</td>`;
      tb.appendChild(tr);
    });
    const leg=document.getElementById('specLegend'); leg.innerHTML='';
    rows.forEach(r=>leg.innerHTML+=`<div class="leg-item"><div class="leg-dot" style="background:${r.color}"></div>m/z ${r.mz}: ${r.name}</div>`);
  }
}
function drawDiagCanvas(){
  const scen=SCENARIOS[activeDiagKey];
  if(scen) drawCanvas('diagCanvas',{...scen.peaks},100,false,1);
}

// ── MONITORING ────────────────────────────────────────
function updateMonitor(peaks, maxI){
  const basePressure=2.4e-8;
  const tot=Object.values(peaks).reduce((a,b)=>a+b,0);
  const totalP=(tot/maxI*basePressure).toExponential(2);
  document.getElementById('hdrPressure').textContent=totalP.replace('e-','×10⁻');
  document.getElementById('monPressure').textContent=totalP;

  const monMap={2:'monH2',18:'monH2O',28:'monN2',32:'monO2',40:'monAr'};
  let hasAlert=false;
  Object.entries(monMap).forEach(([mz,elId])=>{
    const el=document.getElementById(elId);
    const v=peaks[mz]||0;
    const frac=v/maxI;
    const pTorr=(frac*basePressure).toExponential(1);
    el.textContent=pTorr;
    el.className='monitor-val';
    if(frac>0.6){el.classList.add('alert');hasAlert=true;}
    else if(frac>0.2){el.classList.add('warn');}
  });
  document.getElementById('alarmBox').style.display=hasAlert?'inline-block':'none';

  // trend push
  TREND_KEYS.forEach(k=>{
    const frac=(peaks[k]||0)/maxI;
    trendData[k].push(frac);
    if(trendData[k].length>30) trendData[k].shift();
  });
  drawTrend();
}

function drawTrend(){
  const canvas=document.getElementById('trendCanvas');
  if(!canvas) return;
  const rect=canvas.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  const W=rect.width||600, H=rect.height||110;
  canvas.width=Math.round(W*dpr); canvas.height=Math.round(H*dpr);
  const ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  const pad={l:48,r:12,t:10,b:24};
  const gW=W-pad.l-pad.r, gH=H-pad.t-pad.b;

  ctx.fillStyle='#060d18'; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#0f1e30'; ctx.lineWidth=1;
  for(let i=0;i<=4;i++){
    const y=pad.t+gH*i/4;
    ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(W-pad.r,y);ctx.stroke();
  }
  ctx.strokeStyle='#1e3050'; ctx.lineWidth=1.2;
  ctx.beginPath();ctx.moveTo(pad.l,pad.t);ctx.lineTo(pad.l,pad.t+gH);ctx.lineTo(W-pad.r,pad.t+gH);ctx.stroke();

  ctx.font='9px sans-serif';
  ctx.fillStyle='#556677'; ctx.textAlign='end';
  ['1.0','0.75','0.5','0.25','0.0'].forEach((v,i)=>ctx.fillText(v,pad.l-3,pad.t+gH*i/4+3));
  ctx.textAlign='center';
  ctx.fillText('Scan →',pad.l+gW/2,H-2);

  TREND_KEYS.forEach(k=>{
    const data=trendData[k];
    if(data.length<2) return;
    ctx.strokeStyle=TREND_COLORS[k]; ctx.lineWidth=1.5;
    ctx.beginPath();
    data.forEach((v,i)=>{
      const x=pad.l+gW*(i/(29));
      const y=pad.t+gH*(1-v);
      i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    });
    ctx.stroke();
    // label at end
    if(data.length>0){
      const lastV=data[data.length-1];
      const lx=pad.l+gW*(data.length-1)/29;
      const ly=pad.t+gH*(1-lastV);
      ctx.fillStyle=TREND_COLORS[k]; ctx.font='8px sans-serif'; ctx.textAlign='left';
      ctx.fillText(`m${k}`,lx+2,ly);
    }
  });
}

// ── SCENARIO ─────────────────────────────────────────
function applyScenario(){
  document.getElementById('customControls').style.display=document.getElementById('scenario').value==='custom'?'block':'none';
  drawSpectrum('specCanvas');
}

// ── SCAN ─────────────────────────────────────────────
function startScan(){
  if(isScanning) return;
  isScanning=true;
  document.getElementById('hdrMode').textContent='SCANNING'; document.getElementById('hdrMode').style.color='#00ff88';
  document.getElementById('scanStatus').textContent='SCANNING...'; document.getElementById('scanStatus').style.color='#00ff88';
  let s=0;
  scanTimer=setInterval(()=>{
    s++; scanCount++;
    document.getElementById('hdrScan').textContent=scanCount;
    drawSpectrum('specCanvas');
    if(s>=30){
      clearInterval(scanTimer); isScanning=false;
      document.getElementById('hdrMode').textContent='IDLE'; document.getElementById('hdrMode').style.color='#00f5ff';
      document.getElementById('scanStatus').textContent='COMPLETE ✓'; document.getElementById('scanStatus').style.color='#00ff88';
    }
  },300);
}
function resetScan(){
  if(scanTimer) clearInterval(scanTimer);
  isScanning=false; scanCount=0;
  TREND_KEYS.forEach(k=>trendData[k]=[]);
  document.getElementById('hdrScan').textContent='—';
  document.getElementById('hdrMode').textContent='STANDBY'; document.getElementById('hdrMode').style.color='#ff9900';
  document.getElementById('hdrPressure').textContent='—';
  document.getElementById('scanStatus').textContent='STANDBY'; document.getElementById('scanStatus').style.color='#ff9900';
  document.getElementById('alarmBox').style.display='none';
  document.getElementById('scenario').value='clean';
  document.getElementById('customControls').style.display='none';
  ['monH2','monH2O','monN2','monO2','monAr','monPressure'].forEach(id=>{
    const el=document.getElementById(id); if(el){el.textContent='—'; el.className='monitor-val';}
  });
  drawTrend();
  drawSpectrum('specCanvas');
}

// ── DIAG ─────────────────────────────────────────────
function initDiag(){
  const grid=document.getElementById('diagScenGrid');
  if(grid.children.length>0) return;
  DIAG_CASES.forEach(d=>{
    const btn=document.createElement('div');
    btn.className='scen-btn'+(d.key===activeDiagKey?' active':'');
    btn.id='dbtn_'+d.id;
    btn.innerHTML=`<h5>${d.label}</h5><p>${d.hint}</p>`;
    btn.onclick=()=>selectDiagCase(d);
    grid.appendChild(btn);
  });
  updateDiagInfo();
}
function selectDiagCase(d){
  activeDiagKey=d.key;
  document.querySelectorAll('.scen-btn').forEach(b=>b.classList.remove('active'));
  const el=document.getElementById('dbtn_'+d.id); if(el) el.classList.add('active');
  document.getElementById('diagAnswer').value='';
  document.getElementById('diagFeedback').innerHTML='';
  updateDiagInfo();
  requestAnimationFrame(()=>drawDiagCanvas());
}
function updateDiagInfo(){
  const scen=SCENARIOS[activeDiagKey];
  document.getElementById('diagScenLabel').textContent=scen?`— ${scen.label}`:'';
  const info=DIAG_INFO[activeDiagKey]; if(!info) return;
  document.getElementById('diagResult').innerHTML=`<div class="di ${info.cls}"><div class="di-icon">${info.ic}</div><div class="di-text"><h4>${info.title}</h4><p>${info.desc}</p></div></div>`;
}
function checkDiag(){
  const ans=document.getElementById('diagAnswer').value;
  if(!ans){document.getElementById('diagFeedback').innerHTML='<p style="color:#ff9900;">원인을 선택하세요.</p>';return;}
  const ok=ans===SCENARIOS[activeDiagKey].answer;
  document.getElementById('diagFeedback').innerHTML=ok
    ?`<div class="di di-ok"><div class="di-icon">🎯</div><div class="di-text"><h4>정답!</h4><p>${SCENARIOS[activeDiagKey].label} 패턴을 올바르게 진단했습니다.</p></div></div>`
    :`<div class="di di-a"><div class="di-icon">❌</div><div class="di-text"><h4>오답</h4><p>정답은 <strong style="color:#ff9900">${SCENARIOS[activeDiagKey].label}</strong>입니다.</p></div></div>`;
}

// ── QUIZ ─────────────────────────────────────────────
function initQuiz(){
  quizAnswers={};
  const body=document.getElementById('quizBody'); body.innerHTML='';
  QUIZ.forEach((q,i)=>{
    const d=document.createElement('div'); d.className='quiz-q';
    d.innerHTML=`<p><strong style="color:#ff9900">Q${i+1}.</strong> ${q.q}</p>
      <div class="quiz-opts">${q.opts.map((o,j)=>`<button class="quiz-opt" id="qo_${i}_${j}" onclick="selectOpt(${i},${j})">${j+1}. ${o}</button>`).join('')}</div>`;
    body.appendChild(d);
  });
  document.getElementById('quizScore').innerHTML='';
}
function selectOpt(qi,oi){
  if(quizAnswers[qi]!==undefined) return;
  quizAnswers[qi]=oi;
  QUIZ[qi].opts.forEach((_,j)=>{
    const el=document.getElementById(`qo_${qi}_${j}`);
    if(j!==oi) el.style.opacity='0.4';
    el.style.cursor='default';
  });
  document.getElementById(`qo_${qi}_${oi}`).style.borderColor='rgba(0,245,255,0.5)';
  document.getElementById(`qo_${qi}_${oi}`).style.background='#102540';
}
function gradeQuiz(){
  let score=0;
  QUIZ.forEach((q,i)=>{
    const sel=quizAnswers[i];
    q.opts.forEach((_,j)=>{
      const el=document.getElementById(`qo_${i}_${j}`); if(!el) return;
      if(j===q.ans) el.classList.add('correct');
      else if(j===sel) el.classList.add('wrong');
    });
    if(sel===q.ans) score++;
  });
  const pct=Math.round(score/QUIZ.length*100);
  const msg=pct>=80?'🎉 우수':pct>=60?'⭕ 보통':'❌ 재학습 필요';
  document.getElementById('quizScore').innerHTML=`<div class="quiz-score">${score}/${QUIZ.length}<br><span style="font-size:15px;font-family:'Noto Sans KR'">(${pct}%) ${msg}</span></div>`;
}
function resetQuiz(){initQuiz();}

// ── LISTENERS ────────────────────────────────────────
document.getElementById('noiseLevel').addEventListener('input',function(){
  document.getElementById('noiseVal').textContent=this.value;
  if(document.getElementById('tab1').classList.contains('active')) drawSpectrum('specCanvas');
});
document.getElementById('massRange').addEventListener('change',()=>drawSpectrum('specCanvas'));
document.getElementById('yScale').addEventListener('change',()=>drawSpectrum('specCanvas'));
['g2','g18','g28','g32','g40','g44'].forEach(id=>{
  document.getElementById(id).addEventListener('input',()=>{
    if(document.getElementById('scenario').value==='custom') drawSpectrum('specCanvas');
  });
});
window.addEventListener('resize',()=>{
  if(document.getElementById('tab1').classList.contains('active')) drawSpectrum('specCanvas');
  if(document.getElementById('tab2').classList.contains('active')) drawDiagCanvas();
});

// ── INIT ─────────────────────────────────────────────
initQuiz();
drawSpectrum('specCanvas');
</script>
